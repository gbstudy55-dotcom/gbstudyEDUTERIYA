{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "vite build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/verify/status",
      "destination": "https://all.codewithvivek.qzz.io/api/verify/status"
    },
    {
      "source": "/api/:match*",
      "destination": "https://all.codewithvivek.qzz.io/api/:match*"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
